{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ecell/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "moduleDetection": "force",
    "strictNullChecks": true
  }
}
