{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ecell/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "noEmit": true,
    "useDefineForClassFields": true
  }
}
